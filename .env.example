DEVICE_PSK=
BRIDGE_PORT=
# Defaults to 0.0.0.0 (all IPv4 interfaces) so devices can connect over the LAN.
BRIDGE_HOST=
LOG_LEVEL=
# Speech recognition: openai-realtime (default), openai-batch, local, or fake.
# Set only the options you need; unset values use documented defaults.
# STT_ENGINE=local
# STT_LOCAL_BACKEND=whisper-cpp
# STT_LOCAL_URL=http://localhost:8080/inference
# STT_LOCAL_PYTHON=python3
# STT_MODEL=mlx-community/whisper-turbo
# STT_LANGUAGE=ja
# LOG_TRANSCRIPTS=false
# OPENAI_API_KEY must be injected from Keychain, never stored here.
# Optional services (values below are examples, not loaded automatically).
# VOICE_MODE=device
# TTS_ENGINE=openai
# MCP_PORT=8791
# MCP_LOCAL_PORT=8792
# MCP_HOST must remain loopback; see docs/setup.md for the public OAuth listener.
# MCP_PUBLIC_URL=https://<your-host>/mcp
# MCP_PASSCODE must be injected when MCP_PUBLIC_URL is set.
# EVENTS_ENABLED=true
# EVENTS_SECRET_KEY must be injected: 32 random bytes in standard base64.
# EVENTS_ENABLED=false disables Events without a storage key.
# QUIET_HOURS=22:00-07:00
# NOTIFY_DEDUP_WINDOW_S=600
# SLACK_ENABLED=false
# ROUTE=mcp
# All credentials come from Keychain; see README.md and docs/*.md.
