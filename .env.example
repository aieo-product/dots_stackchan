DEVICE_PSK=
BRIDGE_PORT=
# Defaults to 0.0.0.0 (all IPv4 interfaces) so devices can connect over the LAN.
BRIDGE_HOST=
LOG_LEVEL=
# Speech recognition: openai-realtime (default), openai-batch, local, or fake.
# Set only the options you need; unset values use documented defaults.
# STT_ENGINE=local
# STT_LOCAL_BACKEND=whisper-cpp
# STT_LOCAL_URL=http://localhost:8080/inference
# STT_LOCAL_PYTHON=python3
# STT_MODEL=mlx-community/whisper-turbo
# STT_LANGUAGE=ja
# LOG_TRANSCRIPTS=false
# OPENAI_API_KEY must be injected from Keychain, never stored here.
